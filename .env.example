DOCSPACE_URL=https://votre-instance.onlyoffice.com
DOCSPACE_API_KEY=REMPLACER_PAR_CLE_DOCSPACE
# Clé de l'API Mistral (console Mistral Studio), distincte de la clé ONLYOFFICE
MISTRAL_API_KEY=REMPLACER_PAR_CLE_MISTRAL
MISTRAL_MODEL=mistral-large-4
MISTRAL_MAX_TOKENS=6000
MCP_AUTH_TOKEN=GENERER_UN_LONG_JETON_ALEATOIRE
# Si le téléchargement DocSpace pointe sur un hôte HTTPS distinct, ajouter
# uniquement son nom d'hôte exact après vérification (sans schéma ni wildcard)
DOCSPACE_DOWNLOAD_HOSTS=
